{
  "PostRequest": [
    {
      "testcaseName": "Login API",
      "endpoint": "/login",
      "contentType": "application/json",
      "loginRequest": {
        "userLoginEmailId": "Team06@gmail.com",
        "password": "TeamSix@123"
      },
      "expectedType": "Bearer",
      "expectedEmail": "Team06@gmail.com",
      "expectedStatus": "ACTIVE",
      "expectedStatusCode": 200
    },
    {
      "testcaseName": "Login with empty password",
      "endpoint": "/login",
      "contentType": "application/json",
      "loginRequest": {
        "userLoginEmailId": "Team06@gmail.com",
        "password": ""
      },
      "expectedStatusCode": 400
    },
    {
      "testcaseName": "Login with empty email",
      "endpoint": "/login",
      "contentType": "application/json",
      "loginRequest": {
        "userLoginEmailId": "",
        "password": "TeamSix@123"
      },
      "expectedStatusCode": 400
    },
    {
      "testcaseName": "Login without request body",
      "endpoint": "/login",
      "contentType": "application/json",
      "expectedStatusCode": 400
    },
    {
      "testcaseName": "Login with invalid content type",
      "endpoint": "/login",
      "contentType": "text/plain",
       "rawBody": "{\"userLoginEmailId\":\"Team06@gmail.com\",\"password\":\"TeamSix@123\"}",
      "expectedStatusCode": 415
    },
    {
      "testcaseName": "Login with invalid endpoint",
      "endpoint": "/loginnnn",
      "contentType": "application/json",
      "loginRequest": {
        "userLoginEmailId": "Team06@gmail.com",
        "password": "TeamSix@123"
      },
      "expectedStatusCode": 404
    },
